	[compat.aeinfinitybooster]
		#If true and AEInfinityBooster is installed, inserting a Dimension Card or
		#Infinity Card into a Wireless Access Point will keep the chunk loaded.
		#Requires AEInfinityBooster to be present, otherwise has no effect.
		chunkLoadingEnabled = true

	[pattern.uploader]
		#Adds an upload button next to Encode in the Pattern Encoding Terminal. It lists every
		#Pattern Container on the network and sends the patterns you carry to the one you pick.
		#ALT + Encode does the same. With JEI it also remembers the recipe category of each pattern.
		enabled = true

	[pattern.restocker]
		#Pull Blank Patterns from ME storage when encoding with an empty blank pattern slot.
		autoRestock = true
		#Show a button on the Pattern Encoding Terminal that turns the encoded pattern back to blank.
		returnButton = true

[networkStock]
	#Lets players with an open AE2 terminal, or a powered linked wireless terminal in their
	#inventory or Curios slots, see what their ME network stores on top of the items in the JEI
	#ingredient list. Turn it off to stop sending network inventory to clients.
	enabled = true
	#Minimum ticks between two inventory updates sent to the same player.
	# Default: 10
	# Range: 1 ~ 200
	syncTicks = 10
