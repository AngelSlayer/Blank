[tools]
	#Whether to merge matter clusters
	is_merge_matter_cluster = true
	#Range damage dealt by the Infinity Sword's right-click attack
	# Default: 10000
	# Range: 100 ~ 100000
	sword_range_damage = 10000
	#Range of the Infinity Sword's right-click attack
	# Default: 32
	# Range: 8 ~ 64
	sword_attack_range = 32
	#Whether kill mode destroys item entities
	is_sword_attack_item_entity = false
	#Whether kill mode destroys projectiles
	is_sword_attack_projectile = false
	#Whether the right-click attack summons lightning within its range
	is_sword_attack_lightning = false
	#Whether the right-click attack deals infinity damage
	is_sword_attack_endless = true
	#Damage dealt by the Infinity Bow and Crossbow arrow rain
	# Default: 10000
	# Range: 100 ~ 100000
	sub_arrow_damage = 10000
	#Number of logs chained by the Infinity Axe
	# Default: 64
	# Range: 16 ~ 128
	axe_chain_count = 64
	#Block-breaking range of the Infinity Pickaxe
	# Default: 8
	# Range: 2 ~ 32
	pickaxe_break_range = 8
	#Block-breaking range of the Infinity Shovel
	# Default: 8
	# Range: 2 ~ 32
	shovel_break_range = 8
	#Default time required to produce a singularity
	# Default: 240
	# Range: > 0
	singularity_time_required = 240
	#Growth rate of Soul Farmland
	# Default: 0.8
	# Range: 0.0 ~ 1.0
	growth_soul_farmland = 0.8
	#Damage dealt by the Crystal Sword's blade slash
	# Default: 200
	# Range: > 0
	blade_slash_damage = 200
	#Radius of the Crystal Sword's blade slash
	# Default: 10
	# Range: 5 ~ 100
	blade_slash_radius = 10
	#Matter units absorbed before the Endest Pearl black hole evaporates
	# Default: 256
	# Range: 16 ~ 4096
	endest_pearl_absorption_limit = 256

[emc]
	#EMC value of a Neutron Pile
	# Default: 512
	# Range: > 0
	neutron_pile_emc = 512
	#EMC value of a Blaze Cube
	# Default: 30568
	# Range: > 0
	blaze_cube_emc = 30568
	#EMC value of a Totem of Undying
	# Default: 1000
	# Range: > 0
	vanilla_totem_emc = 1000
	#Whether ProjectE or Equivox raises singularity recipe counts to at least 10000 items
	enable_projecte_singularity_count_boost = true

[channel]
	#Fast update interval for channels
	# Default: 1
	# Range: 1 ~ 40
	channel_fast_update_rate = 1
	#Full update interval for channels
	# Default: 40
	# Range: 20 ~ 1200
	channel_full_update_rate = 40
	#Maximum number of channels per player
	# Default: 16
	# Range: 4 ~ 64
	max_channels_pre_player = 16
	#Maximum number of public channels
	# Default: 128
	# Range: 32 ~ 1024
	max_public_channels = 128

[misc]
	#Enables advanced tooltips for development purposes
	use_advance_tooltips = false
	#Tracking range of immortal item entities
	# Default: 1000.0
	# Range: 1.0 ~ 10000.0
	endless_item_entity_range = 1000.0
	#Tracking speed of immortal item entities
	# Default: 3.0
	# Range: 1.0 ~ 50.0
	endless_item_entity_speed = 3.0
	#Flight speed of the Infinity Elytra
	# Default: 1.5
	# Range: 0.0 ~ 100.0
	infinity_elytra_flying_speed = 1.5
	#Damage radius of Infinity Elytra flight collisions
	# Default: 100.0
	# Range: 0.0 ~ 10000.0
	infinity_elytra_flying_damage_range = 100.0
	#Whether the Infinity Helmet grants night vision
	infinity_helmet_night_vision = true
	#Base movement speed of the Infinity Boots
	# Default: 0.1
	# Range: 0.01 ~ 1.0
	boot_speed_base = 0.1
	#Infinity Boots speed multiplier while flying
	# Default: 1.1
	# Range: 0.1 ~ 5.0
	boot_speed_flying_multiplier = 1.1
	#Infinity Boots speed multiplier while swimming
	# Default: 1.2
	# Range: 0.1 ~ 5.0
	boot_speed_swimming_multiplier = 1.2
	#Infinity Boots speed multiplier while sneaking
	# Default: 0.1
	# Range: 0.01 ~ 1.0
	boot_speed_sneaking_multiplier = 0.1
	#Infinity Boots speed multiplier while moving backward
	# Default: 0.25
	# Range: 0.01 ~ 1.0
	boot_speed_backward_multiplier = 0.25
	#Infinity Boots speed multiplier while strafing
	# Default: 0.45
	# Range: 0.01 ~ 1.0
	boot_speed_strafing_multiplier = 0.45
	#Additional Infinity Boots speed while sprinting
	# Default: 0.2
	# Range: 0.01 ~ 1.0
	boot_speed_sprinting_multiplier = 0.2
	#Whether the Neutron Wolf Armor grants its bond and totem mechanics
	wolf_enabled = true
	#Radius around its owner in which the wolf is unharmed and can absorb a lethal hit
	# Default: 5.0
	# Range: 0.0 ~ 64.0
	wolf_bond_radius = 5.0
	#Distance at which damage reduction stops decaying
	# Default: 25.0
	# Range: 1.0 ~ 128.0
	wolf_max_range = 25.0
	#Damage reduction kept at and beyond wolf_max_range
	# Default: 0.5
	# Range: 0.0 ~ 1.0
	wolf_min_reduction = 0.5
	#Damage reduction cap against armor-bypassing or invulnerability-bypassing damage
	# Default: 0.3
	# Range: 0.0 ~ 1.0
	wolf_hax_reduction = 0.3
	#Durability the wolf armor must pay to refuse a lethal hit (0 disables the cost)
	# Default: 500
	# Range: 0 ~ 100000
	wolf_totem_durability_cost = 500
	#Cooldown of the bond that absorbs a lethal hit aimed at the owner
	# Default: 3
	# Range: 0 ~ 3600
	wolf_bond_cooldown_seconds = 3
	#Extra max health granted to a wolf wearing the armor
	# Default: 100.0
	# Range: 0.0 ~ 1024.0
	wolf_health_bonus = 100.0
	#Damage reduction while an armored nautilus is in water
	# Default: 0.99
	# Range: 0.0 ~ 1.0
	nautilus_water_damage_reduction = 0.99
	#Extra movement speed multiplier granted by the nautilus armor
	# Default: 0.5
	# Range: 0.0 ~ 10.0
	nautilus_speed_bonus = 0.5
